<Window x:Class="Nepesseg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nepesseg"
        mc:Ignorable="d"
        Title="Új ország felvétele" Height="450" Width="807">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="269"/>
            <ColumnDefinition Width="Auto" MinWidth="269"/>
            <ColumnDefinition Width="Auto" MinWidth="269"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="55.7"/>
            <RowDefinition Height="55.7"/>
            <RowDefinition Height="55.7"/>
            <RowDefinition Height="55.7"/>
            <RowDefinition Height="55.7"/>
            <RowDefinition Height="55.7"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" HorizontalContentAlignment="Center" FontSize="20" Margin="10,10,10,10" Content="Új ország felvétele" Grid.Column="1"></Label>
        
        <Label Grid.Row="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Margin="10,10,10,10" Content="Ország:"/>
        <TextBox Grid.Row="1" VerticalContentAlignment="Center" Margin="10,10,10,10" FontSize="15" Name="orszagLabel" Text="Chile" Grid.Column="1"/>

        <Label Grid.Row="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Margin="10,10,10,10" Content="Terület:"/>
        <TextBox Grid.Row="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="10,10,10,10" FontSize="15" Name="teruletlabel" Text="756950" Grid.Column="1"/>

        <Label Grid.Row="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Margin="10,10,10,10" Content="Népesség:"/>
        <TextBox Grid.Row="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="10,10,10,10" FontSize="15" Name="nepessegLabel" Text="19458000" Grid.Column="1"/>

        <Label Grid.Row="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Margin="10,10,10,10" Content="Főváros:"/>
        <TextBox Grid.Row="4" VerticalContentAlignment="Center" Margin="10,10,10,10" FontSize="15" Name="fovarosLabel" Text="Santiago" Grid.Column="1"/>

        <Label Grid.Row="5" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Margin="10,10,10,10" Content="Főváros lakossága:"/>
        <TextBox Grid.Row="5" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="10,10,10,10" FontSize="15" Name="fovarnepLabel" Text="6257516" Grid.Column="1"/>

        <Button Grid.Row="3" Margin="50,10,50,10" Content="Mentés" Name="mentes" Grid.Column="2" Click="MentesgombClick"/>
        <Button Grid.Row="7" Margin="100,25,20, 0" Content="Kilépés" Name="kilep" Grid.Column="2" Click="KilepesgombClick"/>
    </Grid>
</Window>
