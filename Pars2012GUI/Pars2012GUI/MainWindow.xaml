<Window x:Class="Pars2012GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pars2012GUI"
        mc:Ignorable="d"
        Title="London 2012 - Férfi kalapácsvetés - selejtező" Height="450" Width="450">
    <Canvas>
        
        
        <StackPanel Width="300" Height="350" Canvas.Top="30" Canvas.Left="70">
            <Label Content="Valasszon versenyzot"/>
            <ComboBox x:Name="Nev" Width="200" HorizontalAlignment="Left" Margin="10" SelectionChanged="Nev_SelectionChanged" />
            <Label x:Name="Csoport" Content="Csoport: "/>
            <Label x:Name="Nemzet" Content="Nemzet: "/>
            <Label x:Name="NemzetKod" Content="Nemezet kod: "/>
            <Label x:Name="Sorozat" Content="Sorozat: "/>
            <Label x:Name="Eredmeny" Content="Eredmeny: "/>
            <Label Content="Zaszlo:"/>
            <Image x:Name="zaszlo" Height="120"/>
        </StackPanel>

    </Canvas>
</Window>
